# ---------------------------------------------------------------------------
# Private staging: a production build on your machine, backed by a real Supabase
# project and Razorpay TEST mode. Copy to .env.staging.local (git-ignored) and fill in.
# Never put live keys (rzp_live_...) here; `npm run staging:check` refuses them.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3260
# Any 32+ random characters, e.g. from: openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=

# --- Supabase (Project Settings -> API, and the "Connect" button) -----------
# Use the SESSION POOLER connection string (works over IPv4), with your DB password.
# Recommended TLS: download the CA certificate (Project Settings -> Database ->
# SSL configuration) to .data/supabase-ca.crt and append:
#   ?sslmode=verify-full&sslrootcert=.data/supabase-ca.crt
# Fallback (encrypted but unverified): ?uselibpqcompat=true&sslmode=require
DATABASE_URL=
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chargeshare

# --- Mode -------------------------------------------------------------------
# For the E2E run: demo data labels + simulated payments, against the real database.
DEMO_MODE=true
PAYMENT_PROVIDER=demo
ALLOW_DEMO_PAYMENTS=true

# --- Razorpay TEST mode (Dashboard -> switch to Test Mode -> Account & Settings -> API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any random string for now; webhooks need a public URL, which local staging doesn't have.
RAZORPAY_WEBHOOK_SECRET=

# --- Email: leave RESEND_API_KEY empty so nothing is sent (outbox only) ------
EMAIL_ALLOWLIST=
