# ---------------------------------------------------------------------------
# ChargeShare environment. Copy to .env.local and fill in what you need.
# With NOTHING set, the app runs in DEMO MODE: embedded Postgres (PGlite),
# local auth, seeded fictional data and simulated payments.
# Never commit .env.local. Variables without NEXT_PUBLIC_ are server-only.
# ---------------------------------------------------------------------------

# Public base URL (used in emails and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs local session cookies. Required in production (32+ random chars):
#   openssl rand -base64 32
SESSION_SECRET=

# --- Database ---------------------------------------------------------------
# Leave empty for demo mode. For Supabase use the direct connection string
# (Project Settings -> Database). Setting this turns demo mode off.
DATABASE_URL=
# DEMO_MODE=true          # force demo mode on/off explicitly
# PGLITE_DATA_DIR=.data/pglite
# UPLOAD_DIR=.data/uploads

# --- Supabase (auth + storage) ---------------------------------------------
# AUTH_PROVIDER=supabase  # default when DATABASE_URL is set; "local" otherwise
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for Storage uploads. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=chargeshare

# --- Payments ---------------------------------------------------------------
# "demo" (default, simulated, no money moves) or "razorpay" (requires DATABASE_URL)
PAYMENT_PROVIDER=demo
# Simulated payments are refused outside demo mode. Only set this for a PRIVATE
# staging environment that should accept simulated payments against a real database.
# ALLOW_DEMO_PAYMENTS=false
DEMO_PAYMENT_SECRET=demo-payment-secret
DEMO_WEBHOOK_SECRET=demo-webhook-secret
# Razorpay (Dashboard -> Account & Settings -> API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------------
# Without RESEND_API_KEY + EMAIL_FROM, emails are captured in the outbox, not sent.
RESEND_API_KEY=
EMAIL_FROM="ChargeShare <bookings@your-verified-domain.in>"
# Only these recipients receive real email (addresses or @domains, comma-separated).
# Keep this set in development and staging so no real customer is emailed by mistake.
EMAIL_ALLOWLIST=@your-company.in
# Production only: send to every recipient (ignored unless NODE_ENV=production).
# EMAIL_ALLOW_ALL_RECIPIENTS=false

# --- Scheduled maintenance -------------------------------------------------
# Bearer token for POST /api/cron/sweep (expires unpaid holds). 16+ chars.
CRON_SECRET=

# --- Maps -------------------------------------------------------------------
# Defaults to OpenStreetMap's public tiles (fine for development only; see
# https://operations.osmfoundation.org/policies/tiles/). Use a commercial tile
# provider (MapTiler, Stadia, Mapbox raster, etc.) in production.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
